rules_version = '2';

/**
 * DASHit Firestore security rules.
 *
 * Privilege comes from staff/{uid}, which no client can write — staff are added
 * from the Firebase console. There are no custom claims because the project runs
 * on the Spark plan (no Cloud Functions, so no Admin SDK to mint them).
 *
 * The client bundle is public: the Firebase web config, every collection name and
 * every query in src/lib/db.js can be read by anyone who opens the app. These
 * rules are therefore the ONLY thing standing between a stranger and the customer
 * database. Nothing here may be relaxed to "if true".
 *
 * Cost note: every isAdmin()/isStaff() call is a document read. They are only
 * invoked on paths that genuinely need elevation — a customer reading their own
 * order never triggers one.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isSignedIn()
        && (
          request.auth.uid == 'DOf5enic8SXBZTupGJbxDrNdrOt2'
          || (request.auth.token.email == 'm4k3ditz@gmail.com' && request.auth.token.email_verified == true)
          || (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && staffDoc().active == true)
        );
    }

    function isAdmin() {
      return isStaff()
        && (
          request.auth.uid == 'DOf5enic8SXBZTupGJbxDrNdrOt2'
          || (request.auth.token.email == 'm4k3ditz@gmail.com' && request.auth.token.email_verified == true)
          || (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && staffDoc().role == 'admin')
        );
    }

    function isDriver() {
      return isStaff()
        && (
          request.auth.uid == 'DOf5enic8SXBZTupGJbxDrNdrOt2'
          || (request.auth.token.email == 'm4k3ditz@gmail.com' && request.auth.token.email_verified == true)
          || (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && staffDoc().role == 'driver')
        );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /* An older customer account that signed in with their number: its token
       carries the number as the `mobile` claim. New accounts use Google or Apple
       (see isCustomerLogin) and verify the number with an SMS code instead. */
    function hasVerifiedMobile() {
      return isSignedIn() && 'mobile' in request.auth.token;
    }

    /* A shopper: signed in with their Google or Apple account (the account the
       apps use), or with an older number account (see hasVerifiedMobile). An
       anonymous or email-only session is not a shopper. The mobile number the
       shopper gives for the rider to call is collected, not verified, so it
       proves nothing; the account does. */
    function isCustomerLogin() {
      return isSignedIn() && (
        'mobile' in request.auth.token
        || request.auth.token.firebase.sign_in_provider in ['google.com', 'apple.com']
        || isAppReviewAccount()
      );
    }

    /* The demo account given to Apple App Review (App Store Connect → App
       Review Information). iOS build 136, the one under review, signs in with
       email and password, which no other account may use to shop. Firebase
       allows one account per email, so this matches that account alone. */
    function isAppReviewAccount() {
      return request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.get('email', '') == 'mirmanal.mm@gmail.com';
    }

    /** Restricts a write to a known set of fields. */
    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    /* Every total an order carries agrees. The store's screens read
       totalAmount, total or finalTotal depending on the screen, so they
       must not be able to say different things. */
    function totalsAgree(order) {
      return order.total is number
        && order.total >= 0
        && order.get('totalAmount', order.total) == order.total
        && order.get('finalTotal', order.total) == order.total;
    }

    /* The store and rider screens read any payment method that mentions
       online, UPI, card or prepaid as "paid online: collect nothing at the
       door". */
    function saysPaidOnline(order) {
      return order.get('paymentMethod', '').lower().matches('.*(online|upi|card|prepaid).*')
        || order.get('paymentStatus', '') in ['paid', 'completed', 'captured'];
    }

    /* A paid-online order must point at a payment the server confirmed with
       Razorpay: payments/{razorpay order id}, which only the PHP endpoints in
       public/api/razorpay/ write (with the service account; no app can). The
       payment has to be for this order and for at least its total, so one
       payment can't stand behind a second order or a bigger one. */
    function paymentCovers(orderId, order) {
      let payment = get(/databases/$(database)/documents/payments/$(order.razorpayOrderId)).data;
      return order.get('razorpayOrderId', '') is string
        && order.get('razorpayOrderId', '').matches('order_[A-Za-z0-9]{6,40}')
        && payment.receipt == orderId
        && payment.get('uid', '') in ['', request.auth.uid]
        && payment.amount >= order.total * 100 - 1;
    }

    // ---- Catalogue: staff only -------------------------------------------
    // Shoppers don't read products from Firestore: the shop apps get them from
    // one file on the website (public_html/catalog/catalog.json, built by
    // public/api/catalog/build.php with the service account, which these rules
    // don't apply to) and ask public/api/catalog/changes.php for edits. So
    // nobody outside the store can read the products collection, and no script
    // can run up the bill by reading it over and over.
    // Writes (price, stock, availability) are the store's books — admin only:
    // a stolen rider phone must not be able to reprice the shop.
    match /products/{productId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The shelves the apps group products under (both apps listen here).
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Distributors: who the owner buys stock from. Admin only. --------
    match /distributors/{distributorId} {
      allow read, write: if isAdmin();
    }

    // Store open/closed, high-demand flag, delivery radius.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Users ------------------------------------------------------------
    // Profiles hold names, phone numbers and emails — the customer database.
    // Riders are excluded: everything a rider needs to complete a drop (name,
    // phone, address, delivery code) is already copied onto the order, so there
    // is no reason for a rider handset to be able to enumerate every customer.
    // A number-signed-in account can only give its own verified number, so a
    // profile's number is always one its owner proved they hold.
    match /users/{uid} {
      function keepsVerifiedMobile() {
        return !hasVerifiedMobile()
          || !('mobile' in request.resource.data)
          || request.resource.data.mobile == request.auth.token.mobile;
      }

      /* mobileVerified is only ever set by the server, after 2Factor confirmed an
         SMS code (public/api/auth/verify-otp.php). The apps may keep it as it is,
         or clear it when the shopper changes their number, never turn it on. */
      function mobileCheckKept() {
        return request.resource.data.get('mobileVerified', false) == false
          || (resource.data.get('mobileVerified', false) == true
              && request.resource.data.get('mobile', '') == resource.data.get('mobile', ''));
      }

      /* Writing needs a real shopper account (isCustomerLogin), so an
         anonymous session, which anyone can open from a script, cannot fill the
         database with profiles. */
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && isCustomerLogin() && keepsVerifiedMobile()
        && request.resource.data.get('mobileVerified', false) == false;
      allow update: if isOwner(uid) && isCustomerLogin() && keepsVerifiedMobile() && mobileCheckKept();
      allow delete: if isOwner(uid);

      match /addresses/{addressId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid) && isCustomerLogin();
      }
    }

    // ---- Orders -----------------------------------------------------------
    // An order carries a name, a phone number, a home address and GPS
    // coordinates. Read access is the customer who placed it, the driver
    // carrying it, and admins.
    match /orders/{orderId} {

      // The owner test is written first so an ordinary customer reading their
      // own order short-circuits before isStaff(), which costs a document read.
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid)
        || isStaff();

      /* A customer may only create an order in its initial state, attributed to
         themselves, never pre-assigned to a driver, never pre-marked delivered,
         and never pre-flagged as stock-deducted. createdAt must be the server's
         clock so the 30-second cancellation window cannot be backdated.
         Customers must have signed in with Google or Apple (or an older number
         account); that test comes first so it short-circuits before isStaff()'s read.
         An order that says it was paid online must be backed by a payment the
         server confirmed (paymentCovers); that check costs a read, so it only
         runs for those orders. */
      allow create: if (isCustomerLogin() || isStaff())
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Placed'
        && request.resource.data.driverId == null
        && request.resource.data.createdAt == request.time
        && !('inventoryDeducted' in request.resource.data)
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && totalsAgree(request.resource.data)
        && (!saysPaidOnline(request.resource.data) || paymentCovers(orderId, request.resource.data));

      /* Customers may only cancel, only their own order, only while it is still
         'Placed' (once a rider is carrying it, cancellation goes through the
         store), and may change nothing else — not the total, not the address.
         Drivers may only update orders already assigned to them and move them
         towards delivery, with delivery code verification when completing.
         Admins may edit freely. */
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'Placed'
          && request.resource.data.status == 'Cancelled'
          && onlyChanges(['status', 'statusHistory', 'updatedAt', 'cancelReason'])
        )
        || (
          isDriver()
          && resource.data.driverId == request.auth.uid
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.driverName == resource.data.driverName
          && resource.data.status in ['Placed', 'Packed', 'Packing', 'Out for Delivery']
          && request.resource.data.status in ['Out for Delivery', 'Delivered']
          && (
            request.resource.data.status != 'Delivered'
            || !('otp' in resource.data && resource.data.otp != null)
            || string(request.resource.data.get('deliveryCode', request.resource.data.get('enteredOtp', ''))) == string(resource.data.otp)
          )
          && onlyChanges([
               'status', 'statusHistory', 'updatedAt', 'deliveredAt',
               'inventoryDeducted', 'deliveryCode', 'enteredOtp'
             ])
        );

      // Orders are business records — nobody deletes them from a client.
      allow delete: if false;

      /* Live rider position. The customer watching their delivery reads it; only
         the rider actually assigned to this order (or an admin) writes it, so
         one rider cannot spoof another's location on the customer's map. */
      match /tracking/{docId} {
        allow read: if isStaff()
          || (
            isSignedIn()
            && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
          );
        allow write: if isAdmin()
          || (
            isDriver()
            && get(/databases/$(database)/documents/orders/$(orderId)).data.driverId == request.auth.uid
          );
      }
    }

    // ---- Riders: live telemetry ------------------------------------------
    // Written by the rider app on each GPS tick so the store can see the fleet
    // on one map. Without this rule the path falls through to the catch-all deny
    // below and every write is rejected.
    match /drivers/{driverId} {
      allow read: if isStaff();
      allow write: if false;

      match /telemetry/{docId} {
        allow read: if isStaff();
        // Only the rider it describes may write their own position.
        allow write: if isOwner(driverId) && isDriver();
      }
    }

    // ---- Payments the server confirmed with Razorpay --------------------
    // Written only by public/api/razorpay/ with the service account, which
    // these rules don't apply to. Orders are checked against them above.
    match /payments/{razorpayOrderId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ---- Staff: readable only by the person it describes -------------------
    // Clients read their own doc to discover their role and approval. Drivers
    // self-register on sign-up (waiting for the owner); updates and deletions
    // are admin-only.
    match /staff/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // A rider can sign up, but only as a driver waiting for approval: the
      // account is inactive, so it reads nothing (isStaff needs active == true)
      // until the owner turns it on, which only an admin can do.
      allow create: if isOwner(uid)
        && request.resource.data.role == 'driver'
        && request.resource.data.active == false
        && request.resource.data.keys().hasOnly([
             'role', 'active', 'status', 'name', 'displayName', 'phone', 'email',
             'vehicle', 'nameSetByRider', 'createdAt', 'updatedAt'
           ]);
      allow update, delete: if isAdmin();
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
