<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DASHit" parent="android:Theme.Material.NoActionBar">
        <!-- Transparent: the app draws edge to edge. The splash library re-applies
             these when it hands over, so opaque colours here would bring back bars. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#0B0B0E</item>
    </style>

    <!-- The system splash: the launch mark on midnight, the same frame the
         animated splash (SplashOverlay) starts from. -->
    <style name="Theme.DASHit.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#061838</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_launch_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.DASHit</item>
    </style>
</resources>
