{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashit-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "dashit-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3100",
        "--directory",
        "out"
      ],
      "port": 3100
    },
    {
      "name": "dashit-emulator",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_FIREBASE_EMULATORS=1",
        "npm",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
