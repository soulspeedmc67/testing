rules_version = '2';

// Product photos the admin takes or chooses (lib/db.js uploadProductPhoto):
// anyone can see them, only staff with the admin role can add or change them.
// Only takes effect once the project has a Storage bucket (Blaze plan).
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{productId}/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.role == 'admin'
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
