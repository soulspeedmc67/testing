# Copy to .env.local and fill from:
# Firebase console → Project settings → General → Your apps → Web app config
#
# .env.local is gitignored. These NEXT_PUBLIC_ values are embedded in the client
# bundle — that is expected for Firebase web apps; your data is protected by
# firestore.rules, not by hiding these keys.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# "mock"  → dev OTP 1234, no SMS, works without billing
# "phone" → real Firebase Phone Auth (needs SMS billing enabled)
NEXT_PUBLIC_AUTH_MODE=mock

# WhatsApp Cloud API (Meta for Developers - WhatsApp Business Platform)
# Optional in dev (falls back to local sandbox). Required for real live WhatsApp delivery.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=dashit_auth_otp
WHATSAPP_TEMPLATE_LANG=en_US
NEXT_PUBLIC_API_URL=http://localhost:5001
