# Copy to .env.local and fill from:
# Firebase console → Project settings → General → Your apps → Web app config
#
# .env.local is gitignored. These NEXT_PUBLIC_ values are embedded in the client
# bundle — that is expected for Firebase web apps; your data is protected by
# firestore.rules, not by hiding these keys.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# "mock"  → dev OTP 1234, no SMS, works without billing
# "phone" → real Firebase Phone Auth (needs SMS billing enabled)
NEXT_PUBLIC_AUTH_MODE=mock

# Confirming a shopper's number (an SMS code through 2Factor) runs on the PHP
# server in public/api/auth/, with its secrets outside the website folder on
# Hostinger: see docs/server-setup.md. Nothing for it goes in this file.
NEXT_PUBLIC_API_URL=http://localhost:5001

# Firebase App Check on the staff pages (/xcyop, /driver): a reCAPTCHA v3 site
# key registered under Firebase console > App Check. Leave empty to keep it off.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
