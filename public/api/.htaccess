# Shared helpers (_http.php, razorpay/_razorpay.php, auth/_sign-in.php) are
# included by the endpoints and never served on their own. This also covers
# every folder below this one.
<FilesMatch "^_">
  Require all denied
</FilesMatch>


# Every endpoint takes a few small JSON fields; refuse anything bigger before
# PHP starts (see also DASHIT_MAX_BODY_BYTES in _http.php).
LimitRequestBody 65536
