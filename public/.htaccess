# DASHit - Hostinger Apache Configuration

# ---------------------------------------------------------------------------
# Staff consoles (/admin, /driver) ARE served from this host, deliberately.
#
# They are reachable so the store can be run from a desktop browser. Being
# reachable is not the same as being open: the page a stranger loads is only a
# sign-in form, and getting past it needs a Firebase Authentication account that
# also carries a staff/{uid} role, which no client can create. firestore.rules
# then refuse the underlying data to anyone without that role. Access is
# controlled by identity, not by hiding the URL.
#
# Both routes are kept out of search results (robots.txt and a noindex meta tag)
# so nobody stumbles onto the login form, which costs nothing and does not
# affect anyone typing the address directly.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Security response headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # The site is never framed, so clickjacking has nothing to overlay.
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "frame-ancestors 'none'"

  # Stop browsers guessing a different Content-Type than the one served.
  Header always set X-Content-Type-Options "nosniff"

  # Don't leak the customer's path (which can name an order) to third parties.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Deny what nothing here needs. Payment is allowed for the page and
  # Razorpay's checkout window (UPI and saved cards use the Payment Request API).
  Header always set Permissions-Policy "camera=(self), geolocation=(self), microphone=(self), payment=(self \"https://api.razorpay.com\"), usb=(), interest-cohort=()"

  # HTTPS only, once the certificate is confirmed working.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # The APK is replaced in place with each new version: always revalidate,
  # and download rather than open.
  <FilesMatch "\.apk$">
    Header always set Cache-Control "public, no-cache"
    Header always set Content-Disposition "attachment; filename=DASHit.apk"
  </FilesMatch>

  # Static exported HTML: kept for a minute, then checked again. It used to
  # allow a day-old copy to be shown while a fresh one was fetched
  # (stale-while-revalidate), so after an upload a returning shopper's first
  # visit still ran the old pages, without a fee the shop had just added.
  <FilesMatch "\.html$">
    Header always set Cache-Control "public, max-age=60, s-maxage=60"
  </FilesMatch>

  # A missing file answers with 404.html, which must never be remembered: a
  # photo uploaded after someone had asked for it stayed "missing" in that
  # person's browser for up to a day.
  <Files "404.html">
    Header always set Cache-Control "no-store"
  </Files>
</IfModule>

# Never serve dotfiles (.env, .git config, editor leftovers).
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "\.(env|log|sh|bak|old|orig|rules)$">
  Require all denied
</FilesMatch>

# Directory listings expose the whole export tree.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Anti-Scraper & Hotlink Protection for Product Assets
  RewriteCond %{REQUEST_URI} ^/products/ [NC]
  RewriteCond %{HTTP_USER_AGENT} (Scrapy|libwww-perl|Python|curl|wget|Ahrefs|Semrush|PetalBot|DotBot) [NC]
  RewriteRule .* - [F,L]

  RewriteCond %{REQUEST_URI} ^/products/ [NC]
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?dashit\.co\.in [NC]
  RewriteCond %{HTTP_REFERER} !^https?://localhost [NC]
  RewriteRule \.(webp|jpg|jpeg|png)$ - [F,L]

  # The web shop is back (launch, 5 October 2026). Product pages are one page
  # now, /product/?id=<id>; older /product/<id>/ links (bookmarks, search
  # results, shared links) are sent there. The tobacco section (/tobacco/) is
  # a real page again; the old 3D demo goes to the shop.
  # (Not for real files: /product/index.html itself must still be served.)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^product/([^/?]+)/?$ /product/?id=$1 [R=302,L,QSD]
  RewriteRule ^hero-3d-demo(/.*)?$ /shop/ [R=302,L]

  # Serve existing files or directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Direct access for sitemap and robots
  RewriteRule ^sitemap\.xml$ /sitemap.xml [L]
  RewriteRule ^robots\.txt$ /robots.txt [L]
  RewriteRule ^site\.webmanifest$ /site.webmanifest [L]

  # Clean URLs: try path/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ /$1/index.html [L]

  # Clean URLs: try path.html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ /$1.html [L]

  # Fallback to 404 page
  ErrorDocument 404 /404.html
</IfModule>

# MIME Types for SEO & Web Standards
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  # The Android app (DASHit.apk at the site root): phones only offer to
  # install it when it is served with this type.
  AddType application/vnd.android.package-archive .apk
  AddType application/xml .xml
</IfModule>

# Browser Caching for Fast Loading
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Next.js hashed assets (immutable)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Media & Images
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # HTML & JSON data (revalidate)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
