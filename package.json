{
  "name": "district-blinkit-clone",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build": "node scripts/generate-sitemap.mjs && next build",
    "export:zip": "rm -f dashit-hostinger-deploy.zip && next build && (cp public/.htaccess out/.htaccess 2>/dev/null || true) && (cd out && zip -q -r ../dashit-hostinger-deploy.zip . -x '*.apk' -x '*.ipa' -x '*.zip' -x '*.tar' -x '*.gz')",
    "start": "next start",
    "test": "jest",
    "seed:firestore": "node scripts/seed-firestore.mjs",
    "fb:rules": "firebase-tools deploy --only firestore:rules,firestore:indexes",
    "fb:emulate": "firebase-tools emulators:start"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@remotion/player": "^4.0.520",
    "animejs": "^4.5.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "framer-motion": "^11.3.19",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.417.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "remotion": "^4.0.520",
    "tailwind-merge": "^3.6.0",
    "three": "^0.172.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7"
  }
}
