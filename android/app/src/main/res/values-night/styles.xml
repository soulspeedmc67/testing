<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base dark application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">#FF5B00</item>
        <item name="colorPrimaryDark">#E04E00</item>
        <item name="colorAccent">#FF5B00</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:statusBarColor">#14171F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#14171F</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#14171F</item>
        <item name="android:colorBackground">#14171F</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#14171F</item>
        <item name="android:windowSplashScreenBackground">#14171F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">#14171F</item>
        <item name="android:windowBackground">#14171F</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#14171F</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
